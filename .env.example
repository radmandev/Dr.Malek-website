# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (optional — without these the site renders bundled default content and the
# contact form reports that it is not yet connected)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_. Used solely by /api/contact to store enquiries.
SUPABASE_SERVICE_ROLE_KEY=
